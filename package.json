{
  "name": "area-calculator",
  "version": "2.1.0",
  "description": "Калькулятор площадей",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder",
    "build:win": "electron-builder --win nsis --x64",
    "build:win:portable": "electron-builder --win portable --x64"
  },
  "dependencies": {
    "electron-updater": "^6.1.8"
  },
  "author": "Danil Kozlov",
  "license": "MIT",
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1"
  },
  "build": {
    "appId": "com.areacalculator.app",
    "productName": "AreaCalc",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "differentialPackage": true
    },
    "portable": {
      "artifactName": "AreaCalculator_portable.exe"
    },
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "icon.ico",
      "css/**/*",
      "js/**/*"
    ]
  }
}

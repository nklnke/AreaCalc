{
  "name": "area-calculator",
  "version": "2.1.0",
  "description": "Калькулятор площадей",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "help": "node scripts/help.js",
    "menu": "node scripts/menu.js",
    "build": "electron-builder",
    "build:win": "electron-builder --win nsis --x64",
    "build:win:portable": "electron-builder --win portable --x64",
    "build:win:dir": "electron-builder --win nsis --x64 --dir --publish never",
    "build:mac": "electron-builder --mac",
    "build:linux": "electron-builder --linux",
    "release:win": "electron-builder --win nsis --x64 --publish always",
    "release:win:draft": "electron-builder --win nsis --x64 --publish onTagOrDraft",
    "release:tag": "node scripts/release-tag.js"
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  },
  "author": "Danil Kozlov",
  "license": "MIT",
  "devDependencies": {
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.areacalculator.app",
    "productName": "AreaCalc",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "differentialPackage": true
    },
    "portable": {
      "artifactName": "AreaCalculator_portable.exe"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.utilities",
      "artifactName": "${productName}_${version}_${arch}.${ext}"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Utility",
      "artifactName": "${productName}_${version}_${arch}.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "nklnke",
        "repo": "AreaCalc"
      }
    ],
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "icon.ico",
      "css/**/*",
      "js/**/*",
      "shared/**/*"
    ]
  }
}
